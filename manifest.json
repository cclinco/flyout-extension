{
  "manifest_version": 3,
  "name": "Flyout Agenda",
  "version": "1.0.0",
  "description": "Create, name, enable/disable, and switch between multiple left-side flyout agendas with editable content. Only one flyout is shown at a time. Links open in the current tab.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle Flyout Agenda",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel-content.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
